<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Dependências deliberadamente enxutas: o worker NÃO referencia
         FluxoDeCaixa.Infrastructure. Ele não toca no event store (Marten) —
         só consome a fila e materializa o read model. Arrastar a Infrastructure
         traria Marten junto, uma dependência que este serviço jamais usa. -->
    <ProjectReference Include="..\FluxoDeCaixa.Consolidacao\FluxoDeCaixa.Consolidacao.csproj" />
    <ProjectReference Include="..\FluxoDeCaixa.Domain\FluxoDeCaixa.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.9" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Carrefour.WKR.Consolidacao</RootNamespace>
  </PropertyGroup>

</Project>
